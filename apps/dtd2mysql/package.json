{
  "name": "dtd2mysql",
  "version": "11.3.0",
  "description": "Command line tool to put the GB rail DTD feed into a MySQL compatible database",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "bin": "bin/dtd2mysql.sh",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "start": "yarn build && tsx ./src/index.ts",
    "gtfs": "yarn build && tsx ./src/index.ts --gtfs",
    "gtfs-zip": "yarn build && tsx ./src/index.ts --gtfs-zip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planarnetwork/gb-transit.git",
    "directory": "apps/dtd2mysql"
  },
  "keywords": [
    "gb",
    "rail",
    "etl",
    "fares",
    "routeing",
    "timetable",
    "dtd"
  ],
  "author": "Linus Norton",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/planarnetwork/gb-transit/issues"
  },
  "homepage": "https://github.com/planarnetwork/gb-transit#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gb-transit/dtd-schema": "workspace:^",
    "@gb-transit/dtd-source": "workspace:^",
    "@gb-transit/feed-parser": "workspace:^",
    "@gb-transit/gtfs": "workspace:^",
    "@gb-transit/gtfs-output": "workspace:^",
    "adm-zip": "0.6.0",
    "byline": "5.0.0",
    "kysely": "0.29.5",
    "memoized-class-decorator": "1.6.1",
    "mysql2": "3.23.1",
    "proj4": "2.20.9",
    "temporal-polyfill": "1.0.4"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/byline": "4.2.36",
    "@types/pg": "8.15.6",
    "pg": "8.16.3",
    "pg-cursor": "2.15.3",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "pg": ">=8",
    "pg-cursor": ">=2"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "pg-cursor": {
      "optional": true
    }
  }
}
