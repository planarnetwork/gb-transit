{
  "name": "gtfsmerge",
  "version": "4.2.0",
  "description": "Merge GTFS data sets",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": "bin/gtfsmerge.sh",
  "scripts": {
    "build": "tsc -b",
    "start": "yarn build && tsx ./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planarnetwork/gb-transit.git",
    "directory": "apps/gtfsmerge"
  },
  "keywords": [
    "gtfs",
    "merge",
    "timetable",
    "transit"
  ],
  "author": "Linus Norton",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/planarnetwork/gb-transit/issues"
  },
  "homepage": "https://github.com/planarnetwork/gb-transit#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gb-transit/gtfs": "workspace:^",
    "@gb-transit/gtfs-loader": "workspace:^",
    "@gb-transit/gtfs-output": "workspace:^",
    "@gb-transit/gtfs-schema": "workspace:^",
    "cheap-ruler": "3.0.2"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "typescript": "7.0.2"
  }
}
