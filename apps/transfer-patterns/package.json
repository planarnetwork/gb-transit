{
  "name": "@gb-transit/transfer-patterns",
  "version": "0.0.0",
  "private": true,
  "description": "Build the transfer pattern file the nightly feed publishes",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "bin": "bin/transfer-patterns.sh",
  "scripts": {
    "build": "tsc -b",
    "start": "yarn build && tsx ./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planarnetwork/gb-transit.git",
    "directory": "apps/transfer-patterns"
  },
