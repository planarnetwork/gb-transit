  "bugs": {
    "url": "https://github.com/planarnetwork/gb-transit/issues"
  },
  "homepage": "https://github.com/planarnetwork/gb-transit#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gb-transit/gtfs": "workspace:^",
    "@gb-transit/gtfs-loader": "workspace:^",
    "raptor-journey-planner": "^5.0.1",
    "transfer-pattern-planner": "^3.3.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "typescript": "7.0.2"
  }
