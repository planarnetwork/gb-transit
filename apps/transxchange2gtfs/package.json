{
  "name": "transxchange2gtfs",
  "version": "2.2.0",
  "description": "Convert TransXChange data to GTFS",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": "bin/transxchange2gtfs.sh",
  "scripts": {
    "build": "tsc -b",
    "start": "yarn build && tsx ./src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planarnetwork/gb-transit.git",
    "directory": "apps/transxchange2gtfs"
  },
  "keywords": [
    "gb",
    "bus",
    "gtfs",
    "timetable",
    "transxchange",
    "naptan"
  ],
  "author": "Linus Norton",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/planarnetwork/gb-transit/issues"
  },
  "homepage": "https://github.com/planarnetwork/gb-transit#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gb-transit/gtfs": "workspace:^",
    "@gb-transit/gtfs-output": "workspace:^",
    "@gb-transit/gtfs-schema": "workspace:^",
    "@gb-transit/naptan": "workspace:^",
    "@js-joda/core": "^6.0.1",
    "adm-zip": "0.6.0",
    "date-holidays": "^3.27.0",
    "proj4": "2.20.9",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@gb-transit/gtfs-loader": "workspace:^",
    "@types/adm-zip": "0.5.8",
    "@types/xml2js": "^0.4.14",
    "fflate": "^0.8.3",
    "typescript": "7.0.2"
  }
}
