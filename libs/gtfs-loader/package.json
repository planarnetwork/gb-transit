{
  "name": "@gb-transit/gtfs-loader",
  "version": "1.7.0",
  "description": "Read a GTFS feed - a zip, a stream, a Response or the bytes - as rows, or as a timetable",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planarnetwork/gb-transit.git",
    "directory": "libs/gtfs-loader"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && tsc -b tsconfig.esm.json && node ../../scripts/dual-package-markers.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "gtfs",
    "timetable",
    "transit",
    "journey planning"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gb-transit/gtfs-schema": "workspace:^",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
