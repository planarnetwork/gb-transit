{
  "name": "gb-transit",
  "private": true,
  "description": "Monorepo for the GB rail DTD tooling: dtd2mysql and the @gb-transit packages it is built from",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "apps/*",
    "libs/*",
    "tests"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node scripts/dual-package-markers.mjs",
    "test": "yarn build && vitest run",
    "watch-test": "vitest",
    "start": "yarn workspace dtd2mysql run start",
    "gtfs": "yarn workspace dtd2mysql run gtfs",
    "gtfs-zip": "yarn workspace dtd2mysql run gtfs-zip",
    "changeset": "changeset",
    "release": "yarn workspaces foreach -A --no-private --topological exec node $PROJECT_CWD/scripts/publish-workspace.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "yarn build && vitest run --config vitest.integration.config.mts",
    "fixture:generate": "tsx apps/dtd2mysql/src/integration/generateFixtures.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planarnetwork/gb-transit.git"
  },
  "author": "Linus Norton",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/planarnetwork/gb-transit/issues"
  },
  "homepage": "https://github.com/planarnetwork/gb-transit#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "dependenciesMeta": {
    "esbuild@0.28.2": {
      "built": true
    },
    "ssh2@1.17.0": {
      "built": true
    }
  }
}
